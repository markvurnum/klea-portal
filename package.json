{
  "name": "klea",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite --port 4601 --strictPort",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "keys": "node key-form.js",
    "passwords": "node set-passwords.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=22"
  }
}